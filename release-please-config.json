{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "include-component-in-tag": false,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "build", "section": "Build System" },
    { "type": "docs", "section": "Documentation" },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "style", "section": "Styles", "hidden": true }
  ],
  "exclude-paths": ["docs/guides", "docs/reference"],
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "@middag-io/react",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["docs/guides", "docs/reference", "packages/contracts", "packages/contracts-codegen"]
    },
    "packages/contracts": {
      "release-type": "node",
      "package-name": "@middag-io/ui-contracts",
      "component": "ui-contracts",
      "include-component-in-tag": true,
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/contracts-codegen": {
      "release-type": "node",
      "package-name": "@middag-io/ui-contracts-codegen",
      "component": "ui-contracts-codegen",
      "include-component-in-tag": true,
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
